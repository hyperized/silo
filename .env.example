# silo daemon configuration (12-factor)
# Copy to .env for local development; never commit .env.

# Identity ---------------------------------------------------------------------

# Node identifier. Must be stable across restarts of the same node.
# If empty, the OS hostname is used.
SILO_NODE_ID=

# Network ---------------------------------------------------------------------

# gRPC listener for inter-node and client traffic.
SILO_GRPC_ADDR=0.0.0.0:7000

# Bootstrap join listener — one-time operator handshake to claim a
# client certificate. Separated from the gRPC port so the listener can
# run without requiring a client certificate (the caller is about to
# get one).
SILO_BOOTSTRAP_ADDR=0.0.0.0:7001

# Gossip listener for SWIM cluster membership traffic.
SILO_GOSSIP_ADDR=0.0.0.0:7100

# Gossip address peers should dial to reach this node. Defaults to
# SILO_GOSSIP_ADDR but that breaks in containers (peers would resolve
# 0.0.0.0 to themselves). Set this to the routable hostname:port of
# this silod — e.g. "silo-a:7100" in docker-compose, or the Pod IP in
# k8s. Required when SILO_GOSSIP_ADDR binds on 0.0.0.0 and the node
# has more than one peer.
SILO_GOSSIP_ADVERTISE=

# HTTP listener for /healthz, /metrics, and (later) the UI/admin API.
SILO_HTTP_ADDR=0.0.0.0:7080

# Block-device (NBD) listener. Empty = NBD off. Set host:port to export silo
# volumes as block devices (e.g. 0.0.0.0:10809). NBD is UNAUTHENTICATED — bind
# it to a trusted/node-local network only. The Kubernetes CSI node plugin dials
# the node-local silod here.
SILO_NBD_ADDR=

# Cluster discovery -----------------------------------------------------------

# Comma-separated list of seed peers — host:port of the gossip listener
# on at least one peer that is already in the cluster. Used at startup
# to bootstrap membership; once joined, gossip handles the rest.
# Example: silo-0:7100,silo-1:7100
SILO_SEEDS=

# DNS domain for SRV-based discovery fallback. If set, silod resolves
# _silo._tcp.<SILO_DOMAIN> when SILO_SEEDS is empty.
# Example: silo.svc.cluster.local
SILO_DOMAIN=

# Storage ---------------------------------------------------------------------

# Directory where chunks are stored on this node.
SILO_DATA_DIR=/var/lib/silo

# Periodic backup target (empty = off): a path, file://, s3://bucket/prefix,
# gs://bucket/prefix, or az://account/container/prefix. Each node exports its
# encrypted chunks + namespace snapshot here. SILO_BACKUP_INTERVAL is a Go
# duration (default 6h).
SILO_BACKUP_TARGET=
SILO_BACKUP_INTERVAL=

# Default chunk size in bytes (configurable per-inode at runtime). 256 KiB
# (262144) keeps copy-on-write amplification low on small writes; raise it for
# large-sequential, capacity-heavy volumes.
SILO_CHUNK_SIZE=262144

# Disk high-watermarks (fractions of the data filesystem used). The soft pair
# (HIGH enter / CLEAR leave, with hysteresis) raises a gossiped DiskPressure
# condition for alerting; HARD makes the node refuse new chunks before ENOSPC.
# Defaults shown; CLEAR < HIGH < HARD must hold.
SILO_DISK_PRESSURE_HIGH=0.85
SILO_DISK_PRESSURE_CLEAR=0.80
SILO_DISK_PRESSURE_HARD=0.95

# Steer new chunks away from nodes signalling DiskPressure (default true). The
# steered replica set keeps a quorum of each chunk's natural ring replicas, so
# reads stay correct. Set false to keep the plain capacity-weighted ring.
SILO_DISK_PRESSURE_STEERING=true

# Default replication factor (configurable per-volume at runtime).
SILO_REPLICATION=3

# Max peer replica sends in flight at once. Bounds grpc's replication
# send-buffer pool under a write storm (without it the pool grows without limit
# and OOM-kills silod). 0 = unbounded. Default 64.
SILO_MAX_CONCURRENT_WRITES=64

# Replication scrubber cadence (Go duration). How often a node re-checks its
# chunks for under-replication and heals. Default 30s.
SILO_SCRUB_INTERVAL=

# Extent-map scrubber cadence (Go duration). The metadata analog of
# SILO_SCRUB_INTERVAL: how often a node re-replicates idle volumes' extent maps
# to their full replica set after a node loss. Default 1m.
SILO_EXTENT_SCRUB_INTERVAL=

# Chunk garbage collector. The GC reclaims chunks no live volume or file
# references anymore (mark-and-sweep over the live reference set). Cadence and
# the minimum chunk age before reclaim (Go durations; default 10m / 1h). The
# grace age is the safety margin for the write-then-record gap — keep it well
# above write latency plus clock skew.
SILO_CHUNK_GC_INTERVAL=
SILO_CHUNK_GC_GRACE=

# Actually delete (truthy). Off by default: the GC runs as a dry run, reporting
# the reclaimable orphan count via metrics without removing anything, so the
# live-set computation can be validated before enabling deletion.
SILO_CHUNK_GC_ENABLE=

# How long a deleted-chunk tombstone is retained before pruning (Go duration).
# Must outlast your worst-case node-down window so a returning node can't
# resurrect a deleted chunk. Default 24h.
SILO_TOMBSTONE_RETENTION=

# Max tolerated HLC clock skew between nodes (Go duration) before silod logs a
# skew alert (silo_hlc_clock_skew_alerts_total). Keep NTP healthy. Default 500ms.
SILO_MAX_CLOCK_SKEW=

# Encryption ------------------------------------------------------------------

# Where the silo encryption key comes from.
#   static  — the key is in SILO_ENCRYPTION_KEY (dev only)
#   file    — the key is in the file at SILO_ENCRYPTION_KEY_PATH (production)
#   aws-kms — KMS-wrapped key at SILO_ENCRYPTION_KEY_PATH; SILO_KMS_KEY_ID = key ARN
#   gcp-kms — KMS-wrapped key at SILO_ENCRYPTION_KEY_PATH; SILO_KMS_KEY_ID = crypto-key name
#   azure-kv — RSA-wrapped key at SILO_ENCRYPTION_KEY_PATH; SILO_KMS_VAULT_URL + SILO_KMS_KEY_NAME
SILO_ENCRYPTION_KEY_SOURCE=static

# Cloud KMS key references (only for the *-kms sources above).
SILO_KMS_KEY_ID=
SILO_KMS_VAULT_URL=
SILO_KMS_KEY_NAME=

# 32-byte AES-256 key, base64-encoded. Required when source=static.
# Generate one with: openssl rand -base64 32
SILO_ENCRYPTION_KEY=

# Path to a file containing the 32-byte raw key. Required when source=file.
# Generate one with: openssl rand 32 > /etc/silo/key && chmod 0400 /etc/silo/key
SILO_ENCRYPTION_KEY_PATH=

# TLS / revocation ------------------------------------------------------------

# Optional path to a CA-signed certificate revocation list. When set, silod
# rejects any mTLS peer whose cert serial is in it, even one that still chains
# to the CA. Build and update it with 'siloctl ca revoke'; leave empty to
# disable revocation checking.
SILO_TLS_CRL=

# Require capability tokens for client-cert callers (1/true to enable). When on,
# CSI/FUSE/operator clients must present a scoped token in SILO_TOKEN, minted
# with 'siloctl auth mint-token'. Cluster nodes are exempt. Default off.
SILO_REQUIRE_TOKENS=

# Observability ---------------------------------------------------------------

# Log level: debug, info, warn, error.
SILO_LOG_LEVEL=info

# Log format: text or json.
SILO_LOG_FORMAT=text

# Profiling: any non-empty value mounts net/http/pprof under /debug/pprof/ on
# SILO_HTTP_ADDR. Off by default (the profiles expose runtime internals and add
# a small always-on sampling cost). Enable on demand to chase a heap or latency
# problem, e.g. `go tool pprof http://<node>:7080/debug/pprof/heap`.
SILO_PPROF=
