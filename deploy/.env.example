# deploy/.env — populated automatically by `make up` on first run.
# This file is not committed (see .gitignore).
#
# Variables here are passed to docker compose for the silo stack.

# 32-byte AES-256 key, base64-encoded. `make up` generates a fresh one
# if deploy/.env does not exist. Delete the file to rotate.
SILO_ENCRYPTION_KEY=

# Logging knobs (optional).
SILO_LOG_LEVEL=info
SILO_LOG_FORMAT=text

# When set to 1/true/yes, silod prints a fresh join token + server
# fingerprint on every boot. Useful when an operator has lost the
# first-boot token. Leave unset for normal operation.
# SILO_PRINT_BOOTSTRAP_TOKEN=1
