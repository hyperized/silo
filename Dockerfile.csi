# syntax=docker/dockerfile:1.7
#
# The silo-csi image: the CSI controller and node plugin in one binary.
# The node plugin shells out to the host's block tooling, so the runtime image
# bundles nbd-client (attach), e2fsprogs/xfsprogs (mkfs), and util-linux
# (mount/umount/blkid). It runs privileged on each node.
#
# Build:   docker build -t silo/silo-csi:dev -f Dockerfile.csi .

# ---- Build stage ------------------------------------------------------------
FROM golang:1.25-alpine AS builder
WORKDIR /src

COPY go.mod ./
COPY go.su[m] ./
RUN go mod download

COPY . .

ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
        -trimpath \
        -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/silo-csi \
        ./cmd/silo-csi

# ---- Runtime stage ----------------------------------------------------------
FROM alpine:3.21

# Host block tooling the node plugin invokes. nbd loads the kernel client;
# e2fsprogs/xfsprogs provide mkfs.ext4/mkfs.xfs; util-linux provides
# mount/umount/blkid. ca-certificates lets the controller talk mTLS to silod.
RUN apk add --no-cache \
        ca-certificates \
        tini \
        nbd \
        e2fsprogs \
        xfsprogs \
        util-linux

COPY --from=builder /out/silo-csi /usr/local/bin/silo-csi

# Runs as root: the node plugin must mount filesystems and drive nbd-client.
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/silo-csi"]
