# syntax=docker/dockerfile:1.7
#
# The silo-csi image: the CSI controller and node plugin in one binary.
# The node plugin attaches volumes by driving the kernel's NBD interface
# directly (no nbd-client) and shells out for filesystem tooling, so the
# runtime image bundles e2fsprogs/xfsprogs (mkfs) and util-linux
# (mount/umount/blkid); nbd-client is kept for manual operator recovery only.
# It runs privileged on each node.
#
# Build:   docker build -t silo/silo-csi:dev -f Dockerfile.csi .

# ---- Build stage ------------------------------------------------------------
FROM golang:1.25-alpine AS builder
WORKDIR /src

COPY go.mod ./
COPY go.su[m] ./
RUN go mod download

COPY . .

ARG VERSION=dev
RUN --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build \
        -trimpath \
        -ldflags "-s -w -X main.version=${VERSION}" \
        -o /out/silo-csi \
        ./cmd/silo-csi

# ---- Runtime stage ----------------------------------------------------------
FROM alpine:3.21

# Host tooling: e2fsprogs/xfsprogs provide mkfs.ext4/mkfs.xfs; util-linux
# provides mount/umount/blkid; nbd provides nbd-client for manual recovery
# only (the attach path drives the kernel directly). ca-certificates lets the
# controller talk mTLS to silod.
RUN apk add --no-cache \
        ca-certificates \
        tini \
        nbd \
        e2fsprogs \
        xfsprogs \
        util-linux

COPY --from=builder /out/silo-csi /usr/local/bin/silo-csi

# Runs as root: the node plugin must mount filesystems and configure NBD devices.
ENTRYPOINT ["/sbin/tini", "--", "/usr/local/bin/silo-csi"]
